{
  "name": "runner",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "cd ios && pod install && cd .. && react-native run-ios",
    "ios-m1": "cd ios && arch -x86_64 pod install --repo-update && cd .. && react-native run-ios",
    "start": "react-native start --reset-cache",
    "clean": "watchman watch-del-all && rm -rf package-lock.json yarn.lock node_modules && cd ios && rm -rf Pods Podfile.lock build && cd ../android && rm -rf .gradle build && cd app && rm -rf build",
    "setup": "npm run clean && npm install --legacy-peer-deps",
    "test": "jest",
    "eslint": "eslint app --ext .js",
    "eslint:fix": "eslint --fix app --ext .js",
    "prettier": "prettier --check \"app/**/*.{js}\"",
    "prettier:fix": "prettier --write \"app/**/*.{js}\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-navigation/bottom-tabs": "^6.3.2",
    "@react-navigation/material-bottom-tabs": "^6.2.2",
    "@react-navigation/native": "^6.0.11",
    "@react-navigation/stack": "^6.2.2",
    "i18next": "^21.8.16",
    "moment": "^2.29.4",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-i18next": "^11.18.3",
    "react-native": "0.76.5",
    "react-native-animatable": "^1.3.3",
    "react-native-app-intro-slider": "^4.0.4",
    "react-native-calendars": "^1.1286.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-draggable": "^3.3.0",
    "react-native-gesture-handler": "2.20.2",
    "react-native-gifted-chat": "^1.0.4",
    "react-native-modal": "^13.0.1",
    "react-native-modal-datetime-picker": "^13.1.2",
    "react-native-pager-view": "6.4.1",
    "react-native-paper": "^5.15.2",
    "react-native-reanimated": "^3.16.1",
    "react-native-restart": "0.0.27",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "3.34.0",
    "react-native-svg": "^15.8.0",
    "react-native-swiper": "^1.6.0",
    "react-native-tab-view": "^3.1.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-vision-camera": "4.6.4",
    "react-redux": "^8.0.2",
    "redux": "4.1.2",
    "redux-logger": "3.0.6",
    "redux-persist": "6.0.0",
    "redux-thunk": "2.4.1",
    "rn-placeholder": "^3.0.3",
    "rn-range-slider": "^2.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli": "15.1.3",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^4.1.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-babel-module": "^5.3.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-unused-imports": "3.2.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@3.6.4"
}
